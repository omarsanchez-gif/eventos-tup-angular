rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthorized() {
      return request.auth != null && request.auth.token.authorized == true;
    }

    function isAdmin() {
      return isAuthorized() && request.auth.token.role == 'admin';
    }

    match /usuarios/{userId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /eventos/{eventId} {
      allow read: if isAuthorized();
      allow create: if isAuthorized()
        && request.resource.data.creadoPorUid == request.auth.uid;
      allow update: if isAuthorized()
        && resource.data.creadoPorUid == request.auth.uid
        && request.resource.data.creadoPorUid == resource.data.creadoPorUid;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
