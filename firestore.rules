rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthorized() {
      return request.auth != null && request.auth.token.authorized == true;
    }

    function isAdmin() {
      return isAuthorized() && request.auth.token.role == 'admin';
    }

    match /usuarios/{userId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /coordinaciones/{coordinationId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /campus/{campusId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /equipos/{equipmentId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /eventos/{eventId} {
      allow read: if isAuthorized();
      allow write: if false;
    }

    match /reservasEquipo/{reservationId} {
      allow read, write: if false;
    }

    match /controlReservasEquipo/{equipmentId} {
      allow read, write: if false;
    }

    match /notificacionesEventos/{notificationId} {
      allow read, write: if false;
    }

    match /configuracion/{configurationId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
